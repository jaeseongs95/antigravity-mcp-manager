{
  "$schema": "https://github.com/jaeseongs95/extenra/schemas/addon-manifest.v3.schema.json",
  "schemaVersion": 3,
  "apiVersion": 3,
  "pluginId": "antigravity-mcp-manager",
  "displayName": "Antigravity MCP Manager",
  "description": "Safe visual manager for global MCP servers in mcp_config.json with read-only plugin inventory, Extenra Desktop & Unified Remote Host Bridge Config Bridge, and Remote Web storage draft sync.",
  "version": "4.3.1",
  "trustLevel": "trusted",
  "compatibility": {
    "surfaces": [
      "desktop",
      "remote-web"
    ],
    "hostProfiles": [
      "antigravity-desktop",
      "antigravity-remote-web"
    ],
    "minHostVersion": "3.3.1"
  },
  "capabilities": [
    "renderer"
  ],
  "entry": {
    "rendererScript": "src/adapters/antigravity/addon-renderer.js"
  },
  "permissions": {
    "ui": {
      "toasts": true,
      "dialogs": true,
      "overlays": true,
      "commands": true,
      "statusItems": true,
      "sectionActions": true,
      "settingsPages": true,
      "canvas": true
    },
    "storage": {
      "namespace": "antigravity-mcp-manager",
      "maxBytes": 262144
    },
    "events": {
      "subscribe": [
        "host:remote-bridge-changed"
      ]
    },
    "configBridge": {
      "scopes": [
        {
          "scopeId": "antigravity:mcp-config",
          "access": "rw",
          "maxBytes": 262144
        },
        {
          "scopeId": "antigravity:plugin-mcp-configs",
          "access": "ro",
          "maxBytes": 262144
        },
        {
          "scopeId": "antigravity:mcp-config-legacy",
          "access": "ro",
          "maxBytes": 262144
        }
      ]
    }
  },
  "isolation": {
    "noTranslate": true,
    "i18nSelfManaged": true,
    "respectsNoTranslate": true,
    "storageNamespace": "antigravity-mcp-manager"
  },
  "loadOrder": 60
}
